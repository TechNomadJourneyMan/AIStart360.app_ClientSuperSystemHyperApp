// Archived 2026-11-18 from prisma/schema.prisma (owner decision: legacy Prisma CRM → archive).
// The table it maps to moved to the `archive` schema (migration 156). Organization had the
// back-relation `crmIntegrations CrmIntegration[]`.

/// CRM integration credentials for Bitrix24 / AmoCRM sync.
model CrmIntegration {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  provider     String   // "bitrix24" | "amocrm"
  domain       String   // e.g. "mycompany.bitrix24.kz" or "mycompany.amocrm.ru"
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  webhookUrl   String?  // incoming webhook URL (Bitrix24)
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  lastSyncAt   DateTime?
  lastSyncStatus String? // "success" | "error" | "partial"
  lastSyncError  String? @db.Text
  syncedDeals    Int     @default(0)
  syncedContacts Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, provider])
  @@map("crm_integrations")
}
