BRIDGE_SESSION_ID=primary
BRIDGE_API_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BRIDGE_API_KEY_ID=primary
BRIDGE_AUTOSTART=true

PORTAL_WEBHOOK_URL=https://aistart360.example/api/webhooks/whatsapp-web
PORTAL_WEBHOOK_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
PORTAL_WEBHOOK_KEY_ID=primary
# Optional durable portal-queue trigger. Blank means disabled. Use either a
# same-origin HTTPS URL or an absolute pathname resolved on the webhook origin.
PORTAL_JOB_DRAIN_URL=
PORTAL_JOB_DRAIN_INTERVAL_MS=10000
PORTAL_JOB_DRAIN_TIMEOUT_MS=5000
# `pull` removes portal-to-bridge network calls for customer sends. The bridge
# claims signed, fenced jobs from the portal and uses its local send queue.
WHATSAPP_WEB_DELIVERY_MODE=direct
PORTAL_OUTBOUND_READY_INTERVAL_MS=1000
PORTAL_OUTBOUND_IDLE_INTERVAL_MS=10000
PORTAL_OUTBOUND_OFFLINE_INTERVAL_MS=10000
PORTAL_OUTBOUND_TIMEOUT_MS=5000

# compose.yaml supplies the container host/port and /data paths. Autostart only
# reconnects an already paired session; it never creates a QR session at boot.
# Pairing-time request hint only; it cannot guarantee what WhatsApp supplies.
# Decide it before a deliberate fresh test-number pairing, not on a live link.
SYNC_FULL_HISTORY=false
# FULL payloads remain discarded without this separate maintenance opt-in.
HISTORY_FULL_SYNC_MAINTENANCE=false
FORCE_HISTORY_RESYNC=false

MAX_BODY_BYTES=32768
MAX_TEXT_CHARS=4096
MAX_INBOUND_TEXT_CHARS=8000
LIVE_MESSAGE_MAX_AGE_SECONDS=300
CATCH_UP_MESSAGE_MAX_AGE_SECONDS=1209600
CATCH_UP_MAX_MESSAGES_TOTAL=200
CATCH_UP_MAX_MESSAGES_PER_CHAT=20
# The accumulator clears everything and imports nothing after any limit breach.
HISTORY_BUFFER_MAX_CHUNKS=64
HISTORY_BUFFER_MAX_CHATS=5000
HISTORY_BUFFER_MAX_MESSAGES=20000
QR_TTL_SECONDS=60

WEBHOOK_OUTBOX_MAX_ENTRIES=10000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

OUTBOUND_RATE_PER_MINUTE=30
OUTBOUND_MIN_INTERVAL_MS=1000
MAX_SEND_QUEUE=100
COMMAND_CACHE_TTL_SECONDS=604800
COMMAND_CACHE_MAX_ENTRIES=5000

HTTP_RATE_PER_MINUTE=120
CONNECT_RATE_PER_15_MINUTES=3
SHUTDOWN_GRACE_MS=15000
