generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// --- Enums --------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ANALYST
  CLIENT
}

enum UserStatus {
  active
  blocked
}

enum ClientStatus {
  active
  at_risk
  inactive
  onboarding
}

enum GrowthStage {
  Seed
  Early
  Growth
  Scale
  Mature
}

enum SubscriptionPlan {
  free
  starter
  growth
  scale
  enterprise
}

enum NotificationType {
  gri_updated
  report
  alert
  project
  team
  system
}

enum NotificationPriority {
  urgent
  high
  medium
  low
}

enum CompanyStatus {
  lead
  active
  blocked
}

enum AdminRequestType {
  registration
  access
  support
}

enum AdminRequestStatus {
  new
  in_review
  waiting_for_info
  approved
  rejected
  escalated
  archived
}

enum RequestPriority {
  low
  medium
  high
  critical
}

// --- Core Auth Models ---------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users              User[]
  clients            Client[]
  crmIntegrations    CrmIntegration[]
  financialSnapshots FinancialSnapshot[]
  // Subscription.orgId is a free-form tenant key, not a FK to organizations -
  // see the note on the Subscription model. No back-relation here.

  @@map("organizations")
}

model FinancialSnapshot {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  period         String       // e.g. "Q1-2026"
  revenueKzt     Float        // Revenue in KZT millions
  marginPct      Float        // Net margin %
  clientsCount   Int
  expensesKzt    Float        // Expenses in KZT millions
  revenueChange  Float        // % change vs prior period
  marginChange   Float        // pp change vs prior period
  clientsChange  Int          // absolute change vs prior period
  expensesChange Float        // % change vs prior period
  recordedAt     DateTime     @default(now())

  @@index([orgId])
  @@map("financial_snapshots")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?   @map("email_verified")
  passwordHash  String?
  name          String?
  role          UserRole    @default(MANAGER)
  status        UserStatus  @default(active)
  avatarUrl     String?
  lastLogin     DateTime?
  orgId         String?
  org           Organization?  @relation(fields: [orgId], references: [id])
  managedClients Client[]      @relation("ManagedClients")
  accounts       Account[]
  sessions       Session[]

  // Backend implementation relations
  uploadedReports Report[]
  notifications   Notification[]
  activityLogs    ActivityLog[]

  // Admin panel relations
  submittedRequests AdminRequest[] @relation("RequestSubmitter")
  assignedRequests  AdminRequest[] @relation("RequestAssignee")
  comments          Comment[]
  auditLogs         AuditLog[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orgId])
  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Business Models ----------------------------------------------------------

model Client {
  id            String       @id @default(cuid())
  name          String
  industry      String
  stage         GrowthStage
  status        ClientStatus @default(active)
  website       String?
  notes         String?      @db.Text
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  managerId     String
  manager       User         @relation("ManagedClients", fields: [managerId], references: [id])

  // GRI Pulse specific data
  forbesRank    Int?
  sector        String?
  orderCycle    Int          @default(30)

  griReports   GriReport[]
  reports      Report[]
  projects     Project[]
  activityLogs ActivityLog[]
  pulseMetrics PulseMetric?
  diagnosticRuns DiagnosticRun[]
  documentSummaries DocumentSummary[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orgId])
  @@index([managerId])
  @@map("clients")
}

model Report {
  id         String @id @default(cuid())
  clientId   String
  client     Client @relation(fields: [clientId], references: [id])
  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  name     String
  category String // GRI, Financial, Growth, Market, Custom
  type     String // pdf, xlsx, csv, docx
  fileUrl  String
  fileSize Int    // bytes
  filePath String // Supabase Storage path

  uploadedAt DateTime @default(now())

  documentSummaries DocumentSummary[]

  @@index([clientId])
  @@index([uploadedBy])
  @@map("reports")
}

model Project {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  name        String
  status      String    @default("active") // active, in_review, completed, paused
  startDate   DateTime?
  endDate     DateTime?
  // Team allocations: [{ userId, allocationPct }]
  team        Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("projects")
}

model Notification {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id])
  type     NotificationType
  priority NotificationPriority @default(medium)
  title    String
  body     String               @db.Text
  isRead   Boolean              @default(false)

  entityType String? // 'client', 'report', 'gri', 'project'
  entityId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model PulseMetric {
  id            String   @id @default(cuid())
  clientId      String   @unique
  client        Client   @relation(fields: [clientId], references: [id])

  lastOrder     DateTime?
  daysSince     Int?
  avgCheck      Float     @default(0)
  volumeChange  Float     @default(0)
  riskScore     Int       @default(0)
  churnProb     Int       @default(0)
  churnLevel    String    @default("low")
  comment       String?   @db.Text
  action        String    @default("monitor")
  history       Json      @default("[]")

  updatedAt     DateTime  @updatedAt

  @@map("pulse_metrics")
}

model GriReport {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  // Total GRI Score (can be 0-100 or 0-1000 depending on version)
  score          Float    @default(0)

  // 7 Blocks Scores (0-100)  used by GRI Pulse
  productScore   Float    @default(0)
  trustScore     Float    @default(0)
  businessModelScore Float @default(0)
  cashScore      Float    @default(0)
  operationsScore Float   @default(0)
  teamScore      Float    @default(0)
  founderScore   Float    @default(0)

  // Domain scores stored as JSON (used by legacy/backend implementation)
  domains        Json?

  // Raw answers and data
  rawData        Json?

  calculatedAt   DateTime @default(now())

  diagnosticRun  DiagnosticRun?

  @@index([clientId, calculatedAt])
  @@map("gri_reports")
}

model ReportDocument {
  id            String   @id @default(cuid())
  name          String
  clientName    String   @map("client_name")
  category      String
  type          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int      @map("file_size_bytes")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([uploadedBy])
  @@map("report_documents")
}

// --- Admin Portal Models ------------------------------------------------------

/// Company entity for admin CRM --- represents an incoming lead or registered company.
model Company {
  id        String        @id @default(cuid())
  name      String
  domain    String?       @unique
  status    CompanyStatus @default(lead)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  requests  AdminRequest[]

  @@map("companies")
}

/// Inbound request --- registration, access upgrade, or support ticket.
model AdminRequest {
  id              String             @id @default(cuid())
  type            AdminRequestType
  status          AdminRequestStatus @default(new)
  priority        RequestPriority    @default(medium)

  // Submitter (nullable --- can be anonymous registration)
  userId          String?
  user            User?              @relation("RequestSubmitter", fields: [userId], references: [id])

  // Company context
  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id])

  // Assigned admin
  assignedAdminId String?
  assignedAdmin   User?              @relation("RequestAssignee", fields: [assignedAdminId], references: [id])

  // Tracking
  source          String?            // utm / manual / invite / api
  payload         Json?              // arbitrary form data from the requester
  rejectionReason String?            @db.Text
  slaDeadline     DateTime?          // auto-set on creation based on priority

  comments        Comment[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([assignedAdminId])
  @@index([companyId])
  @@index([userId])
  @@map("admin_requests")
}

/// Thread comment on an AdminRequest --- internal admin notes or external communications.
model Comment {
  id        String       @id @default(cuid())
  requestId String
  request   AdminRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  text      String       @db.Text
  isInternal Boolean     @default(true) // internal note vs. message to user
  createdAt DateTime     @default(now())

  @@index([requestId])
  @@index([authorId])
  @@map("comments")
}

/// CRM integration credentials for Bitrix24 / AmoCRM sync.
model CrmIntegration {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  provider     String   // "bitrix24" | "amocrm"
  domain       String   // e.g. "mycompany.bitrix24.kz" or "mycompany.amocrm.ru"
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  webhookUrl   String?  // incoming webhook URL (Bitrix24)
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  lastSyncAt   DateTime?
  lastSyncStatus String? // "success" | "error" | "partial"
  lastSyncError  String? @db.Text
  syncedDeals    Int     @default(0)
  syncedContacts Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, provider])
  @@map("crm_integrations")
}

/// Immutable audit log --- every admin action is recorded here.
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // "request" | "user" | "company"
  entityId    String
  action      String   // "approve" | "reject" | "block" | "assign" | "comment" | ...
  performedBy String
  performer   User     @relation(fields: [performedBy], references: [id])
  timestamp   DateTime @default(now())
  diff        Json?    // { before: {...}, after: {...} }
  ipAddress   String?

  @@index([entityType, entityId])
  @@index([performedBy])
  @@map("audit_logs")
}

// --- AI Diagnostic Engine Models -----------------------------------------------

enum DiagnosticStatus {
  pending
  parsing
  analyzing
  hitl_review
  completed
  failed
}

model DiagnosticRun {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  
  status      DiagnosticStatus @default(pending)
  
  // URLs or references to the uploaded source documents for this run
  sourceFiles Json?      @default("[]")
  
  // n8n Webhook ID or Run ID for tracing and async resuming
  n8nRunId    String?
  
  // If the run resulted in a generated GRI report, link it here
  griReportId String?    @unique
  griReport   GriReport? @relation(fields: [griReportId], references: [id])

  // Any errors or metadata
  metadata    Json?      @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@map("diagnostic_runs")
}

model DocumentSummary {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  reportId    String?
  report      Report?  @relation(fields: [reportId], references: [id])

  // Direct owner (Supabase documents.user_id) so RAG retrieval can scope by
  // user without the fragile clientId -> clients.managerId chain (migration 046).
  userId      String?  @map("user_id")

  // High-level parsed data from the document (e.g. key financial metrics, full text parsed)
  content     String   @db.Text
  metadata    Json?    @default("{}")

  createdAt   DateTime @default(now())

  chunks      DocumentChunk[]

  @@index([clientId])
  @@index([reportId])
  @@index([userId])
  @@map("document_summaries")
}

model DocumentChunk {
  id                String   @id @default(cuid())
  documentSummaryId String
  documentSummary   DocumentSummary @relation(fields: [documentSummaryId], references: [id], onDelete: Cascade)
  
  content           String   @db.Text
  
  // Use Unsupported for pgvector's vector type
  embedding         Unsupported("vector(1536)")?
  
  metadata          Json?    @default("{}")
  createdAt         DateTime @default(now())

  @@index([documentSummaryId])
  @@map("document_chunks")
}

// --- Growth/Acquisition + Sharing + Billing Models -----------------------------

enum SharedReportType {
  survey
  gri
  point_a
  point_b
}

enum AcquiringProvider {
  stripe
  cloudpayments
  kaspi
  halyk
  mir
}

enum SubscriptionTier {
  pilot
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum PaymentStatus {
  stub
  pending
  succeeded
  failed
}

/// Lead captured by the public "mini-GRI" diagnostic on the landing page.
model MiniGriLead {
  id           String   @id @default(cuid())
  email        String
  locale       String   @default("ru")
  answers      Json
  overallScore Int      @map("overall_score")
  blockScores  Json     @map("block_scores")
  source       String?
  converted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("mini_gri_leads")
}

/// Shareable read-only link to a report (survey/gri/point_a/point_b) for a company.
model SharedReport {
  id            String           @id @default(cuid())
  token         String           @unique
  type          SharedReportType
  companyId     String
  createdById   String?
  // Roles allowed to be referenced: "expert", "admin", "client_employee".
  // Empty array = anyone-with-link.
  audienceRoles String[]         @default([])
  expiresAt     DateTime?
  revoked       Boolean          @default(false)
  views         Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([token])
  @@index([companyId])
  @@map("shared_reports")
}

/// Billing subscription for an organization (one-to-one with Organization).
model Subscription {
  id               String             @id @default(cuid())
  // orgId is a free-form tenant key (companies.id / auth user id), NOT an
  // organizations.id. It is intentionally NOT a FK relation: the billing tenant
  // here is the company/user, and forcing organizations(id) made every trial
  // upsert fail its FK and silently no-op. Mirrors PaymentTransaction.orgId.
  orgId            String             @unique
  tier             SubscriptionTier   @default(pilot)
  status           SubscriptionStatus @default(trialing)
  provider         AcquiringProvider?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("subscriptions")
}

/// Individual payment/checkout transaction. Money stored as integer minor units.
model PaymentTransaction {
  id         String            @id @default(cuid())
  orgId      String
  provider   AcquiringProvider
  amount     Int // minor units (e.g. cents)
  currency   String            @default("USD") // ISO 4217, e.g. "USD", "KZT"
  planKey    String?
  status     PaymentStatus     @default(stub)
  externalId String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([orgId])
  @@map("payment_transactions")
}
