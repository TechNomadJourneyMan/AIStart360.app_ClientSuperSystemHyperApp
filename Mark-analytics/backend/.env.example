# ============================================================
# Mark Analytics backend — environment template
# Copy to .env, fill required values. Do NOT commit .env.
# ============================================================

# ---- Core ----
APP_ENV=development                # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-32-bytes-random
API_PREFIX=/api/v1

# ---- Supabase (та же инстанция, что у Vercel-фронта) ----
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=               # HS256 secret из Supabase → Settings → API → JWT Secret
SUPABASE_WEBHOOK_SECRET=           # для верификации входящих webhooks

# ---- Postgres ----
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mark
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/mark

# Production (Supabase Pooler, transaction mode):
# DATABASE_URL=postgresql+asyncpg://postgres:[PWD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# DATABASE_URL_DIRECT=postgresql://postgres:[PWD]@db.[PROJECT].supabase.co:5432/postgres

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# Production (Upstash):
# REDIS_URL=rediss://default:[PWD]@[host].upstash.io:6379

# ---- Object storage ----
# Local dev (MinIO):
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=mark-raw
R2_REGION=auto
# Production (Cloudflare R2):
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=...

# ---- Neo4j (опционально, MVP без графа можно стартовать) ----
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- AI providers ----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://your-portal.vercel.app    # рекомендуется OpenRouter
OPENROUTER_APP_NAME=Mark Analytics

GOOGLE_AI_STUDIO_API_KEY=

# ---- Firecrawl (scraping with anti-bot bypass) ----
# https://firecrawl.dev — handles JS rendering, captchas, proxies.
# Free tier: 500 scrapes/month. Set self-hosted base URL if you run it yourself.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_S=120

# AI feature flags
AI_FEATURE_KEY_CACHE=true
AI_FEATURE_SEMANTIC_CACHE=true
AI_FEATURE_FALLBACK=true
AI_DAILY_COST_CEILING_USD=100
AI_DEFAULT_TIMEOUT_SECONDS=60

# Embeddings (local fastembed)
EMBED_MODEL=BAAI/bge-m3
EMBED_CACHE_DIR=.cache/fastembed

# ---- CORS ----
# Explicit origin allow-list (comma-separated). Includes Next.js dev (3000),
# Vite dev (5173), Vite preview (5174). Add your prod portal domain here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://your-portal.vercel.app
# Optional regex for preview deployments (e.g. Vercel branch URLs).
# Leave blank to disable. Example: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# ---- Crawling ----
CRAWLER_USER_AGENT_POOL_PATH=
CRAWLER_DEFAULT_RATE_LIMIT_RPM=30
PROXY_PROVIDER=                     # none | brightdata | iproyal
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mark-backend
