# Frontend build-time env for the Vercel deployment.
# Same-origin API — the SPA and the Python read-API share this deployment's origin.
VITE_API_BASE_URL=/api/v1
# Supabase — SAME project as the portal (shared auth / JWT).
VITE_SUPABASE_URL=https://<portal-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<portal anon key>
# Portal production origin — whitelisted for postMessage (session + insights bridge).
VITE_PORTAL_ORIGIN=https://PORTAL_DOMAIN
