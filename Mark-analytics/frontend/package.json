{
  "name": "market-kz-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Market Monitoring System Kazakhstan — Web frontend",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.ts",
    "gen:api:file": "openapi-typescript ./openapi.json -o src/types/api.ts",
    "prebuild": "test -f openapi.json && npm run gen:api:file || echo 'No openapi.json snapshot, skipping codegen'"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@tanstack/react-router": "^1.81.0",
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/supercluster": "^7.1.3",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "d3-scale-chromatic": "^3.0.0",
    "date-fns": "^4.1.0",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^5.0.0",
    "nuqs": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3",
    "react-i18next": "^15.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "recharts": "^2.13.0",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@tailwindcss/vite": "^4.0.0-beta.4",
    "@tanstack/router-devtools": "^1.81.0",
    "@tanstack/router-plugin": "^1.81.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.0.0-beta.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
