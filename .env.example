# ─────────────────────────────────────────────────────────────────────────────
# AIStart360 — environment template
# Copy to `.env.local` and fill in real values. CRITICAL vars (see lib/env.ts)
# must be set or the server will fail fast on startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma) ────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime (pgbouncer).
DATABASE_URL="postgresql://postgres.your-id:password@aws-pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://postgres.your-id:password@aws-db.supabase.com:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public project URL + anon key (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session signing secret for NextAuth/Auth.js. AUTH_SECRET is preferred;
# NEXTAUTH_SECRET is read as a fallback by some libs (e.g. lib/giga-cookie.ts).
# Generate a UNIQUE value per environment — never reuse this file's example:
#   openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
# Canonical app URL (used for redirects, email links, OpenRouter HTTP-Referer).
AUTH_URL=http://localhost:3000
# Google OAuth (required by lib/auth.config.ts — app crashes at runtime if unset).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Super-admin (ГИГА-Панель) ────────────────────────────────────────────────
# Password gate for /api/giga-admin/auth.
GIGA_ADMIN_PASSWORD=change-me-strong-secret
# Secret used to sign the giga-admin cookie (lib/giga-cookie.ts).
# Falls back to AUTH_SECRET / NEXTAUTH_SECRET if unset.
GIGA_COOKIE_SECRET=

# ── AI Providers ─────────────────────────────────────────────────────────────
# REQUIRED for all AI features. Every live AI call routes through OpenRouter
# (lib/ai/openrouter.ts): document extraction, Point A narrative, insights,
# Pulse briefing, Point B strategy, GRI AI. Set this or AI features fail.
OPENROUTER_API_KEY=
# NOT currently read by the code — safe to leave blank (kept for future direct use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Observability (Langfuse) ─────────────────────────────────────────────────
# Self-hosted default host: http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3002

# ── Orchestration (n8n) ──────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/document-parser

# ── Background jobs (Inngest) ────────────────────────────────────────────────
# REQUIRED in production. GRI calculation and document parsing run as Inngest
# functions served at /api/inngest (app/api/inngest/route.ts). In Inngest Cloud
# mode the SDK needs these keys or the synced endpoint is rejected and those
# jobs never execute. Get them from the Inngest dashboard; set in Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Meta messaging (Instagram + WhatsApp inbox) ──────────────────────────────
# Server-only credentials for /api/webhooks/meta and Meta Graph API calls.
# Never use NEXT_PUBLIC_* names and never expose these values to the browser.
META_GRAPH_API_VERSION=v25.0
META_GRAPH_TIMEOUT_MS=10000
# WhatsApp/shared Meta app: Dashboard > App settings > Basic > App secret.
META_APP_SECRET=
# Optional Instagram Login app secret. Leave empty when Instagram and WhatsApp
# belong to the same Meta app; the webhook then falls back to META_APP_SECRET.
INSTAGRAM_APP_SECRET=
# A separate strong random value chosen by you for Meta webhook verification.
META_WEBHOOK_VERIFY_TOKEN=

# Instagram Login for a Professional (Business/Creator) account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Manual-operator HUMAN_AGENT replies only; never enables the tag for AI replies.
# Enable only after confirming eligibility/policy compliance in Meta.
INSTAGRAM_HUMAN_AGENT_ENABLED=
# Each bounded provider page scans up to this many conversations (1..100,
# default 25). The durable Workflow may continue with later cursor pages.
INSTAGRAM_BACKFILL_MAX_CONVERSATIONS=25
# Full message text retention (30..730 days); suppressed-contact state remains.
OMNICHANNEL_RETENTION_DAYS=180

# WhatsApp Cloud API. Reused by both the omnichannel inbox and expert alerts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Experimental WhatsApp Web bridge (QR / Baileys) ─────────────────────────
# Unofficial connector with a real account restriction/logout risk. Keep off
# until a separate test number and persistent bridge host are ready.
WHATSAPP_WEB_BRIDGE_ENABLED=false
WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:3100
WHATSAPP_WEB_BRIDGE_SESSION_ID=primary
# App → bridge control/send HMAC. Use a separate 32+ byte random secret.
WHATSAPP_WEB_BRIDGE_API_SECRET=
WHATSAPP_WEB_BRIDGE_API_KEY_ID=primary
# Bridge → /api/webhooks/whatsapp-web HMAC. Never reuse the API secret.
WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET=
WHATSAPP_WEB_BRIDGE_TIMEOUT_MS=10000
# `direct` (default) calls the bridge URL. `pull` stores an RPC-only delivery
# and lets the long-running bridge fetch it from the portal, so sends do not
# depend on a public quick tunnel.
WHATSAPP_WEB_DELIVERY_MODE=direct
# Processing backend for signed Meta and WhatsApp Web webhooks:
# - `workflow`: durable Vercel Workflow for Instagram + WhatsApp Cloud API;
# - `database`: durable Postgres queue (required by the QR/WebSocket bridge);
# - `inngest`: legacy shared Inngest event path.
OMNICHANNEL_PROCESSING_BACKEND=workflow
# Database mode is fail-closed and accepts only this dedicated, least-privilege
# pooled DSN. It never falls back to the broad application DATABASE_URL.
OMNICHANNEL_PERSISTENCE=
OMNICHANNEL_DATABASE_URL=
# Development-only escape hatch for processing inside the signed webhook when
# an Inngest account is unavailable. Production ignores this value.
OMNICHANNEL_INLINE_PROCESSING=false
# Optional previous inbound webhook key during rotation.
WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET_PREVIOUS=
# Pair/logout normally require a personal super_admin session, not break-glass.
WHATSAPP_WEB_BRIDGE_ALLOW_BREAK_GLASS_PAIRING=false

# Variables consumed by the separate services/whatsapp-web-bridge process.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3100
BRIDGE_SESSION_ID=primary
# Must equal WHATSAPP_WEB_BRIDGE_API_SECRET in this same environment.
BRIDGE_API_SECRET=
BRIDGE_AUTH_DIR=./services/whatsapp-web-bridge/.data/auth
BRIDGE_STATE_DIR=./services/whatsapp-web-bridge/.data/state
BRIDGE_AUTOSTART=false
# Pairing-time Desktop/history request hint only; WhatsApp may still send a
# partial snapshot or nothing. Decide before a fresh test-number pairing.
SYNC_FULL_HISTORY=false
# FULL payloads are discarded unless this separate maintenance opt-in is true.
# Never toggle either history flag against an already-linked live session.
HISTORY_FULL_SYNC_MAINTENANCE=false
# Best-effort one-time replay switch for a still-pending history notification.
# It clears only processedHistoryMessages and writes a persistent marker; it
# does not request history. Normal existing sessions usually require re-pairing.
FORCE_HISTORY_RESYNC=false
PORTAL_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/whatsapp-web
# Must equal WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET; keep it different from API secret.
PORTAL_WEBHOOK_SECRET=
PORTAL_WEBHOOK_KEY_ID=primary
# Optional signed recovery kick for the durable portal queue. Enable only when
# OMNICHANNEL_PROCESSING_BACKEND=database is deployed on the portal.
PORTAL_JOB_DRAIN_URL=
PORTAL_JOB_DRAIN_INTERVAL_MS=10000
PORTAL_JOB_DRAIN_TIMEOUT_MS=5000
PORTAL_OUTBOUND_READY_INTERVAL_MS=1000
PORTAL_OUTBOUND_OFFLINE_INTERVAL_MS=10000
PORTAL_OUTBOUND_TIMEOUT_MS=5000
# Offline catch-up accepts Baileys `messages.upsert` type=append plus only the
# newest unreadCount messages from 1:1 `messaging-history.set` chats. The same
# limits are shared across both sources in one connection and reset on reconnect.
CATCH_UP_MESSAGE_MAX_AGE_SECONDS=1209600
CATCH_UP_MAX_MESSAGES_TOTAL=200
CATCH_UP_MAX_MESSAGES_PER_CHAT=20
# In-memory history accumulation fails closed and clears buffered data if any
# bound is exceeded. These limits do not imply complete history coverage.
HISTORY_BUFFER_MAX_CHUNKS=64
HISTORY_BUFFER_MAX_CHATS=5000
HISTORY_BUFFER_MAX_MESSAGES=20000

# ── Notifications ────────────────────────────────────────────────────────────
# Resend (transactional email).
RESEND_API_KEY=re_...
# Recipient for admin alerts. ADMIN_NOTIFICATION_EMAIL is preferred,
# ADMIN_EMAIL is read as a fallback (lib/notifications.ts).
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com
ADMIN_EMAIL=
# Telegram bot alerts (optional).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Comma-separated chat ids for admin alerts (falls back to TELEGRAM_CHAT_ID).
TELEGRAM_ADMIN_CHAT_IDS=
# Personal Telegram account assistant (MTProto, not Bot API).
# Get TELEGRAM_API_ID / TELEGRAM_API_HASH from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: npx tsx scripts/telegram-create-session.ts
TELEGRAM_USER_SESSION=
# Public username of the personal account clients will message.
TELEGRAM_PERSONAL_USERNAME=your_personal_username
# Used by /api/telegram/personal/sync. Vercel Cron can send Bearer CRON_SECRET;
# TELEGRAM_PERSONAL_SYNC_SECRET wins when set.
TELEGRAM_PERSONAL_SYNC_SECRET=
CRON_SECRET=
TELEGRAM_PERSONAL_DIALOG_LIMIT=40
TELEGRAM_PERSONAL_MESSAGES_PER_DIALOG=5
TELEGRAM_PERSONAL_MAX_MESSAGES_PER_RUN=20

# ── Expert escalation channels («Позвать эксперта») ──────────────────────────
# When a client opens an expert case, dedicated channels alert the EXPERTS team
# (separate from admin alerts above). Each channel auto-activates as soon as its
# creds are set — no extra enable flag needed.
#
# Telegram: reuses TELEGRAM_BOT_TOKEN (above). Set a dedicated experts chat list
# (comma-separated). Falls back to TELEGRAM_ADMIN_CHAT_IDS / TELEGRAM_CHAT_ID.
TELEGRAM_EXPERTS_CHAT_IDS=
# Email: reuses RESEND_API_KEY (above). Dedicated experts distro; falls back to
# ADMIN_NOTIFICATION_EMAIL / ADMIN_EMAIL.
EXPERTS_NOTIFICATION_EMAIL=experts@yourcompany.com
# WhatsApp Cloud API reuses WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID above.
# Add recipients below to activate expert alerts independently of the inbox.
# Comma-separated numbers in E.164 (e.g. +77011234567,+77027654321).
WHATSAPP_EXPERTS_TO=
#
# Optional explicit on/off overrides per channel ('1'|'true'|'on' to force on,
# '0'|'false'|'off' to force off). Leave empty to auto-activate from creds.
ASSISTANT_ESCALATION_TELEGRAM=
ASSISTANT_ESCALATION_EMAIL=
ASSISTANT_ESCALATION_WHATSAPP=

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Auth endpoints are unprotected if these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── OSINT / market intelligence (optional) ───────────────────────────────────
# Empty state is shown if unset.
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Market Intelligence backend — base URL of the "Mark-analytics" read-API.
# PRODUCTION: the single Mark-analytics Vercel project serves BOTH the SPA and the
# read-API, so this is that project's origin + /api/v1 (e.g.
# https://market.aistart360.app/api/v1). The portal proxies /api/market/* here.
# If unset, the Market portal renders honest empty states; it never fabricates
# data. Local dev (running the backend): http://localhost:8000/api/v1
MARKET_API_URL=

# ── Feature flags ────────────────────────────────────────────────────────────
# Enable /api/dev/* auth backdoors (create accounts of any role). NEVER set in
# production — requires NODE_ENV!=production AND this flag = 1.
ENABLE_DEV_AUTH_ROUTES=
# Enable pgvector embedding of uploaded documents (RAG). Off by default.
ENABLE_DOCUMENT_EMBEDDINGS=
# Render the Choco portfolio CASE-STUDY demo on insights/intelligence/competitors.
# Leave empty in production so real accounts see honest empty states.
DEMO_DASHBOARD=

# Origin встроенного приложения «Рынок» (Mark-analytics). Портал грузит его в
# iframe и синхронизирует сессию/инсайты через postMessage; CSP frame-src/
# connect-src берутся ОТСЮДА автоматически (см. next.config.mjs). PRODUCTION —
# URL проекта Mark-analytics на Vercel (напр. https://market.aistart360.app).
# Локально (запущен Vite): http://localhost:5173
NEXT_PUBLIC_MARKET_APP_URL=

# ── Kaspi.kz эквайринг (первый реальный платёжный провайдер) ────────────────
# Без этих переменных Kaspi-провайдер честно деградирует к demo-стабу.
# Точные endpoint'ы/поля сверить с мерчант-документацией Kaspi Pay.
KASPI_API_BASE=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
# Подпись callback'ов /api/webhooks/kaspi (HMAC-SHA256, заголовок x-kaspi-signature)
KASPI_WEBHOOK_SECRET=
# Опционально: курс конвертации USD-тарифов в KZT (Kaspi принимает только KZT)
KASPI_USD_KZT_RATE=
