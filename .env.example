# 1. Supabase (Public & Secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Database (Prisma)
# DATABASE_URL is for connection pooling (Transaction mode, e.g. port 6543)
# DIRECT_URL is for migrations and direct access (Session mode, e.g. port 5432)
DATABASE_URL="postgresql://postgres.your-id:password@aws-pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-id:password@aws-db.supabase.com:5432/postgres"

# 3. NextAuth / Auth.js (v5)
# AUTH_SECRET is a random string (generate with: openssl rand -base64 32)
AUTH_SECRET=pY8xT9lR2mB4qW1zV7nJ6kD5gF3sA2hG
AUTH_URL=http://localhost:3002

# 4. Google OAuth
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
