# 1. Supabase (Public & Secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Database (Prisma)
DATABASE_URL="postgresql://postgres.your-id:password@aws-pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-id:password@aws-db.supabase.com:5432/postgres"

# 3. NextAuth / Auth.js (v5)
AUTH_SECRET=pY8xT9lR2mB4qW1zV7nJ6kD5gF3sA2hG
AUTH_URL=http://localhost:3000

# 4. AI Providers
# Preferred: OpenRouter (proxies to Anthropic with prompt caching).
# Required by lib/ai/prompt-cache.ts — without OPENROUTER_API_KEY or ANTHROPIC_API_KEY,
# every AI endpoint throws on cold deploy.
OPENROUTER_API_KEY=sk-or-v1-...
# Fallback: used only if OPENROUTER_API_KEY is not set.
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# 5. Langfuse (Observability)
# Self-hosted default: http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3002

# 6. n8n (AI orchestrator backbone — THIS BRANCH)
# Prod: fly.io-hosted at https://ai-marketplace-n8n.fly.dev
N8N_API_URL=https://ai-marketplace-n8n.fly.dev
N8N_API_KEY=your-n8n-jwt-api-key
# Explicit webhook URL. Leave blank to use N8N_API_URL/webhook/{workflow}
N8N_WEBHOOK_URL=
# HMAC-SHA256 shared secret for outbound trigger + inbound callback verification
N8N_CALLBACK_SECRET=generate-a-random-64-char-hex-string
AI_BACKBONE=n8n

# 7. Resend (Email)
RESEND_API_KEY=re_...

# 8. Admin Notifications
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com

# 9. Telegram Bot Notifications (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
