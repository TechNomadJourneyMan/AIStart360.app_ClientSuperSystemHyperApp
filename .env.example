# ─────────────────────────────────────────────────────────────────────────────
# AIStart360 — environment template
# Copy to `.env.local` and fill in real values. CRITICAL vars (see lib/env.ts)
# must be set or the server will fail fast on startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma) ────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime (pgbouncer).
DATABASE_URL="postgresql://postgres.your-id:password@aws-pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://postgres.your-id:password@aws-db.supabase.com:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public project URL + anon key (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing secret for the app's own tokens (staff cookie, MFA step-up, WebAuthn
# challenges, internal calls) when GIGA_COOKIE_SECRET is unset. AUTH_SECRET is
# preferred; NEXTAUTH_SECRET is still read as a fallback (the name is historic —
# NextAuth itself was removed; sign-in is Supabase Auth).
# Generate a UNIQUE value per environment — never reuse this file's example:
#   openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
# Canonical app URL (used for redirects, email links, OpenRouter HTTP-Referer).
AUTH_URL=http://localhost:3000
# Google sign-in is configured in Supabase Auth (Providers → Google), not here.

# ── Super-admin (ГИГА-Панель) ────────────────────────────────────────────────
# The panel is entered only with a personal staff account (/login + 2FA); the
# shared-password «break-glass» entry (GIGA_ADMIN_PASSWORD) was removed.
# Secret used to sign the staff cookie, «от имени» sessions and MFA step-up
# tokens (lib/security/signed-token.ts). Falls back to AUTH_SECRET /
# NEXTAUTH_SECRET if unset.
GIGA_COOKIE_SECRET=
# TEST ONLY — Playwright entry into the panel without Supabase
# (lib/admin/e2e-auth-seam-edge.ts). Ignored by production builds; needs ≥32
# characters. Never set it on Vercel.
# E2E_AUTH_SEAM_SECRET=

# ── AI Providers ─────────────────────────────────────────────────────────────
# Built-in AI provider. Without routes configured in the admin panel (ai_routes,
# migration 094) every AI call goes to OpenRouter with this key: document
# extraction, Point A narrative, insights, Pulse briefing, Point B strategy,
# GRI AI, agents. Required unless the owner routes all tiers to another
# provider and stores its key in the panel. An OpenRouter key entered in the
# panel (provider "openrouter") takes precedence over this one.
OPENROUTER_API_KEY=
# Optional env fallback key for the Alem Plus provider (OpenAI-compatible,
# https://llm.alem.ai/v1). Used only when a route points at the "alem" provider
# and no Alem key is stored in the panel. Prefer storing keys in the panel.
ALEM_API_KEY=
# HMAC key for one-time Journey device-link codes. SERVER ONLY; production
# refuses to create/redeem codes unless this contains at least 32 random bytes.
# Generate independently per environment: openssl rand -base64 48
JOURNEY_CONNECT_CODE_SECRET=
# Enables the real two-browser-context Journey sync test against a disposable
# Supabase project with migrations 069/070 applied. Never point this at prod.
JOURNEY_SYNC_E2E=0
# Development/test only. Playwright uses this to exercise the explicit demo
# fallback even when a developer has a real OpenRouter key locally.
JOURNEY_FORCE_DEMO=0
# NOT currently read by the code — safe to leave blank (kept for future direct use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Observability (Langfuse) ─────────────────────────────────────────────────
# Self-hosted default host: http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3002

# ── Orchestration (n8n) ──────────────────────────────────────────────────────
# n8n is not used: no code reads an n8n variable, documents are parsed by the
# Inngest pipeline. If n8n is ever adopted it calls a signed inbound webhook of
# ours — never an outbound URL with client data (docs/platform/06-integrations.md).

# ── Background jobs (Inngest) ────────────────────────────────────────────────
# REQUIRED in production. GRI calculation and document parsing run as Inngest
# functions served at /api/inngest (app/api/inngest/route.ts). In Inngest Cloud
# mode the SDK needs these keys or the synced endpoint is rejected and those
# jobs never execute. Get them from the Inngest dashboard; set in Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Meta messaging (Instagram + WhatsApp inbox) ──────────────────────────────
# Server-only credentials for /api/webhooks/meta and Meta Graph API calls.
# Never use NEXT_PUBLIC_* names and never expose these values to the browser.
META_GRAPH_API_VERSION=v25.0
META_GRAPH_TIMEOUT_MS=10000
# WhatsApp/shared Meta app: Dashboard > App settings > Basic > App secret.
META_APP_SECRET=
# Optional Instagram Login app secret. Leave empty when Instagram and WhatsApp
# belong to the same Meta app; the webhook then falls back to META_APP_SECRET.
INSTAGRAM_APP_SECRET=
# A separate strong random value chosen by you for Meta webhook verification.
META_WEBHOOK_VERIFY_TOKEN=

# Instagram Login for a Professional (Business/Creator) account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Manual-operator HUMAN_AGENT replies only; never enables the tag for AI replies.
# Enable only after confirming eligibility/policy compliance in Meta.
INSTAGRAM_HUMAN_AGENT_ENABLED=
# Each bounded provider page scans up to this many conversations (1..100,
# default 25). The durable Workflow may continue with later cursor pages.
INSTAGRAM_BACKFILL_MAX_CONVERSATIONS=25
# Full message text retention (30..730 days); suppressed-contact state remains.
OMNICHANNEL_RETENTION_DAYS=180

# WhatsApp Cloud API. Reused by both the omnichannel inbox and expert alerts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Experimental WhatsApp Web bridge (QR / Baileys) ─────────────────────────
# Unofficial connector with a real account restriction/logout risk. Keep off
# until a separate test number and persistent bridge host are ready.
WHATSAPP_WEB_BRIDGE_ENABLED=false
WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:3100
WHATSAPP_WEB_BRIDGE_SESSION_ID=primary
# App → bridge control/send HMAC. Use a separate 32+ byte random secret.
WHATSAPP_WEB_BRIDGE_API_SECRET=
WHATSAPP_WEB_BRIDGE_API_KEY_ID=primary
# Bridge → /api/webhooks/whatsapp-web HMAC. Never reuse the API secret.
WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET=
WHATSAPP_WEB_BRIDGE_TIMEOUT_MS=10000
# `direct` (default) calls the bridge URL. `pull` stores an RPC-only delivery
# and lets the long-running bridge fetch it from the portal, so sends do not
# depend on a public quick tunnel.
WHATSAPP_WEB_DELIVERY_MODE=direct
# Processing backend for signed Meta and WhatsApp Web webhooks:
# - `workflow`: durable Vercel Workflow for Instagram + WhatsApp Cloud API;
# - `database`: durable Postgres queue (required by the QR/WebSocket bridge);
# - `inngest`: legacy shared Inngest event path.
OMNICHANNEL_PROCESSING_BACKEND=workflow
# Database mode is fail-closed and accepts only this dedicated, least-privilege
# pooled DSN. It never falls back to the broad application DATABASE_URL.
OMNICHANNEL_PERSISTENCE=
OMNICHANNEL_DATABASE_URL=
# Development-only escape hatch for processing inside the signed webhook when
# an Inngest account is unavailable. Production ignores this value.
OMNICHANNEL_INLINE_PROCESSING=false
# Optional previous inbound webhook key during rotation.
WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET_PREVIOUS=

# Variables consumed by the separate services/whatsapp-web-bridge process.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3100
BRIDGE_SESSION_ID=primary
# Must equal WHATSAPP_WEB_BRIDGE_API_SECRET in this same environment.
BRIDGE_API_SECRET=
BRIDGE_AUTH_DIR=./services/whatsapp-web-bridge/.data/auth
BRIDGE_STATE_DIR=./services/whatsapp-web-bridge/.data/state
BRIDGE_AUTOSTART=false
# Pairing-time Desktop/history request hint only; WhatsApp may still send a
# partial snapshot or nothing. Decide before a fresh test-number pairing.
SYNC_FULL_HISTORY=false
# FULL payloads are discarded unless this separate maintenance opt-in is true.
# Never toggle either history flag against an already-linked live session.
HISTORY_FULL_SYNC_MAINTENANCE=false
# Best-effort one-time replay switch for a still-pending history notification.
# It clears only processedHistoryMessages and writes a persistent marker; it
# does not request history. Normal existing sessions usually require re-pairing.
FORCE_HISTORY_RESYNC=false
PORTAL_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/whatsapp-web
# Must equal WHATSAPP_WEB_BRIDGE_WEBHOOK_SECRET; keep it different from API secret.
PORTAL_WEBHOOK_SECRET=
PORTAL_WEBHOOK_KEY_ID=primary
# Optional signed recovery kick for the durable portal queue. Enable only when
# OMNICHANNEL_PROCESSING_BACKEND=database is deployed on the portal.
PORTAL_JOB_DRAIN_URL=
PORTAL_JOB_DRAIN_INTERVAL_MS=10000
PORTAL_JOB_DRAIN_TIMEOUT_MS=5000
PORTAL_OUTBOUND_READY_INTERVAL_MS=1000
PORTAL_OUTBOUND_OFFLINE_INTERVAL_MS=10000
PORTAL_OUTBOUND_TIMEOUT_MS=5000
# Offline catch-up accepts Baileys `messages.upsert` type=append plus only the
# newest unreadCount messages from 1:1 `messaging-history.set` chats. The same
# limits are shared across both sources in one connection and reset on reconnect.
CATCH_UP_MESSAGE_MAX_AGE_SECONDS=1209600
CATCH_UP_MAX_MESSAGES_TOTAL=200
CATCH_UP_MAX_MESSAGES_PER_CHAT=20
# In-memory history accumulation fails closed and clears buffered data if any
# bound is exceeded. These limits do not imply complete history coverage.
HISTORY_BUFFER_MAX_CHUNKS=64
HISTORY_BUFFER_MAX_CHATS=5000
HISTORY_BUFFER_MAX_MESSAGES=20000

# ── Notifications ────────────────────────────────────────────────────────────
# Resend (transactional email).
RESEND_API_KEY=re_...
# Отправитель транзакционных писем. Домен должен быть верифицирован в Resend.
# Домен ОБЯЗАН быть верифицирован в Resend (resend.com/domains), иначе письмо не уйдёт.
# Шлём с ПОДДОМЕНА support.aistart360.app; корневой aistart360.app числится
# за другим аккаунтом Resend и НЕ работает (разница в одну точку).
EMAIL_FROM=AIStart360 <support@support.aistart360.app>
# Куда придут ответы на письмо и какой адрес показывать в подвале (необязательно).
EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@aistart360.app
# Часовой пояс, в котором получателю показывают дату и время в письме.
EMAIL_TIMEZONE=Asia/Almaty
# Recipient for admin alerts. ADMIN_NOTIFICATION_EMAIL is preferred,
# ADMIN_EMAIL is read as a fallback (lib/notifications.ts).
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com
ADMIN_EMAIL=
# Telegram bot alerts (optional).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Comma-separated chat ids for admin alerts (falls back to TELEGRAM_CHAT_ID).
# «Анкета завершена» (company, contact, phone, revenue, goal + sheet link) goes here.
TELEGRAM_ADMIN_CHAT_IDS=

# Google Sheets mirror of the onboarding survey via a Google Apps Script web app
# (no Sheets API / service account). Setup: scripts/google-apps-script/README.md
# Web-app /exec URL of the deployed script (bound to the target spreadsheet).
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
# Optional shared secret; must equal Script Properties → WEBHOOK_SECRET.
GOOGLE_APPS_SCRIPT_SECRET=
# Optional: spreadsheet id (URL part between /d/ and /edit) — only used to build
# the link shown in Telegram/email notifications.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab name (created automatically if missing). Default: Анкета
GOOGLE_SHEETS_SURVEY_TAB=
# Personal Telegram account assistant (MTProto, not Bot API).
# Get TELEGRAM_API_ID / TELEGRAM_API_HASH from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: npx tsx scripts/telegram-create-session.ts
TELEGRAM_USER_SESSION=
# Public username of the personal account clients will message.
TELEGRAM_PERSONAL_USERNAME=your_personal_username
# Used by /api/telegram/personal/sync. Vercel Cron can send Bearer CRON_SECRET;
# TELEGRAM_PERSONAL_SYNC_SECRET wins when set.
TELEGRAM_PERSONAL_SYNC_SECRET=
CRON_SECRET=
TELEGRAM_PERSONAL_DIALOG_LIMIT=40
TELEGRAM_PERSONAL_MESSAGES_PER_DIALOG=5
TELEGRAM_PERSONAL_MAX_MESSAGES_PER_RUN=20

# ── Expert escalation channels («Позвать эксперта») ──────────────────────────
# When a client opens an expert case, dedicated channels alert the EXPERTS team
# (separate from admin alerts above). Each channel auto-activates as soon as its
# creds are set — no extra enable flag needed.
#
# Telegram: reuses TELEGRAM_BOT_TOKEN (above). Set a dedicated experts chat list
# (comma-separated). Falls back to TELEGRAM_ADMIN_CHAT_IDS / TELEGRAM_CHAT_ID.
TELEGRAM_EXPERTS_CHAT_IDS=
# Email: reuses RESEND_API_KEY (above). Dedicated experts distro; falls back to
# ADMIN_NOTIFICATION_EMAIL / ADMIN_EMAIL.
EXPERTS_NOTIFICATION_EMAIL=experts@yourcompany.com
# WhatsApp Cloud API reuses WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID above.
# Add recipients below to activate expert alerts independently of the inbox.
# Comma-separated numbers in E.164 (e.g. +77011234567,+77027654321).
WHATSAPP_EXPERTS_TO=
#
# Optional explicit on/off overrides per channel ('1'|'true'|'on' to force on,
# '0'|'false'|'off' to force off). Leave empty to auto-activate from creds.
ASSISTANT_ESCALATION_TELEGRAM=
ASSISTANT_ESCALATION_EMAIL=
ASSISTANT_ESCALATION_WHATSAPP=

# ── Rate limiting ───────────────────────────────────────────────────────────
# lib/rate-limit.ts. Counters are shared by all instances: Upstash Redis when
# BOTH Upstash vars are set (optional, lower latency), otherwise Postgres
# (public.rate_limit_hit, migration 100 — must be applied). In-memory counters
# are used only outside production (dev without DATABASE_URL, tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: force a store (upstash | postgres | memory; memory is ignored in production).
RATE_LIMIT_BACKEND=
# Emergency switch: '1' = when the store is down, allow requests in EVERY bucket
# (default: auth/2FA/AI/bots/uploads/admin buckets refuse with 503, low-risk ones allow).
RATE_LIMIT_FAIL_OPEN=
# Optional HMAC key for identifiers (user id / IP) before they are stored;
# defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY. Same on all instances.
RATE_LIMIT_HASH_SECRET=

# ── OSINT / market intelligence (optional) ───────────────────────────────────
# Empty state is shown if unset.
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Market Intelligence backend — base URL of the "Mark-analytics" read-API.
# PRODUCTION: the single Mark-analytics Vercel project serves BOTH the SPA and the
# read-API, so this is that project's origin + /api/v1 (e.g.
# https://market.aistart360.app/api/v1). The portal proxies /api/market/* here.
# If unset, the Market portal renders honest empty states; it never fabricates
# data. Local dev (running the backend): http://localhost:8000/api/v1
MARKET_API_URL=

# ── Feature flags ────────────────────────────────────────────────────────────
# Enable /api/dev/* auth backdoors (create accounts of any role). NEVER set in
# production — requires NODE_ENV!=production AND this flag = 1.
ENABLE_DEV_AUTH_ROUTES=
# Enable pgvector embedding of uploaded documents (RAG). Off by default.
ENABLE_DOCUMENT_EMBEDDINGS=
# Render the Choco portfolio CASE-STUDY demo on insights/intelligence/competitors.
# Leave empty in production so real accounts see honest empty states.
DEMO_DASHBOARD=

# Origin встроенного приложения «Рынок» (Mark-analytics). Портал грузит его в
# iframe и синхронизирует сессию/инсайты через postMessage; CSP frame-src/
# connect-src берутся ОТСЮДА автоматически (см. next.config.mjs). PRODUCTION —
# URL проекта Mark-analytics на Vercel (напр. https://market.aistart360.app).
# Локально (запущен Vite): http://localhost:5173
NEXT_PUBLIC_MARKET_APP_URL=

# ── Kaspi.kz эквайринг (первый реальный платёжный провайдер) ────────────────
# Без этих переменных Kaspi-провайдер честно деградирует к demo-стабу.
# Точные endpoint'ы/поля сверить с мерчант-документацией Kaspi Pay.
KASPI_API_BASE=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
# Подпись callback'ов /api/webhooks/kaspi (HMAC-SHA256, заголовок x-kaspi-signature)
KASPI_WEBHOOK_SECRET=
# Опционально: курс конвертации USD-тарифов в KZT (Kaspi принимает только KZT)
KASPI_USD_KZT_RATE=

# ─── Используются в коде, но раньше не были описаны ──────────────────────────
# Канонический адрес портала. Пустая строка недопустима — на неё уже падала
# сборка (metadataBase). Если не задан, код берёт https://portal.aistart360.app.
AUTH_URL=https://portal.aistart360.app
NEXTAUTH_URL=https://portal.aistart360.app
# Запасной источник origin для входа по ключам доступа (WebAuthn); можно
# перечислить несколько через запятую.
NEXT_PUBLIC_APP_ORIGIN=https://portal.aistart360.app
NEXT_PUBLIC_APP_URL=https://portal.aistart360.app
# Домен для ключей доступа. По умолчанию берётся из origin запроса.
WEBAUTHN_RP_ID=portal.aistart360.app
# Ключ шифрования секретов в БД (AES-256-GCM): токены CRM, TOTP и ключи API
# ИИ-провайдеров (ai_credentials, 094). Ровно 32 байта в hex (64 символа) или
# base64. ОБЯЗАТЕЛЕН для хранения ключей ИИ-провайдеров: без него панель и бот
# откажутся сохранять ключ (открытым текстом ключи не хранятся). Смена ключа
# делает сохранённые ключи нечитаемыми — их придётся ввести заново.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=
# Telegram: имя бота и секрет вебхука.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Telegram-бот панели администратора (@Command_panel_aistart360_bot):
# /api/telegram/admin. Когда заданы ТОКЕН И СЕКРЕТ, уведомления персонала,
# кнопки одобрения и привязка сотрудников переходят в этот бот; без них всё
# остаётся на TELEGRAM_BOT_TOKEN. Секрет — случайная строка 1–256 символов
# [A-Za-z0-9_-] (openssl rand -hex 32). Регистрация вебхуков:
#   npx tsx scripts/telegram/set-webhooks.ts https://<домен>
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_ADMIN_WEBHOOK_SECRET=
# Telegram-бот экспертов (@aist360notificationbot): /api/telegram/expert —
# карточки клиентов, диагностики, отчёты и уведомления экспертам.
TELEGRAM_EXPERT_BOT_TOKEN=
TELEGRAM_EXPERT_BOT_USERNAME=
TELEGRAM_EXPERT_WEBHOOK_SECRET=
# Каналы утреннего CRM-дайджеста (1/true — включить).
CRM_DIGEST_WHATSAPP=
CRM_DIGEST_SMS=
# Маскот «Гри»: 0 — выключить.
NEXT_PUBLIC_FEATURE_MASCOT=1
# Адрес портала для смоук-проверок и локальных скриптов.
AISTART360_PORTAL_ORIGIN=https://portal.aistart360.app
AISTART360_SMOKE_PORTAL_ORIGIN=https://portal.aistart360.app
# Разрешить http://localhost в проверках безопасности (только для разработки).
AISTART360_ALLOW_INSECURE_LOCALHOST=

# ─── ИИ-агенты (docs/platform/05-agents.md) ──────────────────────────────────
# Inngest: в проде нужны INNGEST_EVENT_KEY и INNGEST_SIGNING_KEY (см. выше);
# для локального dev-сервера Inngest — INNGEST_DEV=1.
INNGEST_DEV=
# Задача агента запускается сразу в фоне того же запроса (Vercel waitUntil).
# false — только через Inngest / cron /api/cron/agents (Bearer CRON_SECRET).
AGENT_INLINE_EXECUTION=
# Дневные бюджеты ИИ в долларах: на одну компанию и на всю платформу.
# Агент не вызовет модель, если оценка вызова превышает остаток. Значения,
# заданные в панели (ai_budgets, 094), важнее этих; здесь — запасные.
AGENT_COMPANY_DAILY_BUDGET_USD=5
AGENT_PLATFORM_DAILY_BUDGET_USD=50

# ─── Шлюз моделей OpenRouter (lib/ai/gateway.ts) ─────────────────────────────
# Модели по уровням. По умолчанию light = anthropic/claude-haiku-4.5,
# standard = anthropic/claude-sonnet-4.5, premium = anthropic/claude-opus-4.8.
AI_MODEL_LIGHT=
AI_MODEL_STANDARD=
AI_MODEL_PREMIUM=
# deny (по умолчанию) — провайдерам запрещено хранить и обучаться на данных;
# strict — ещё и только провайдеры с нулевым хранением (ZDR); off — без ограничений.
AI_PRIVACY_MODE=deny
# Цены для оценки стоимости ДО вызова (бюджет), $ за 1M токенов, по id модели.
# По умолчанию по уровню: light 1/5, standard 3/15, premium 15/75. Фактическая
# стоимость берётся из ответа OpenRouter. Пример:
# {"anthropic/claude-sonnet-4.5":{"in":3,"out":15}}
AI_PRICE_TABLE=

# ─── Уведомления команды (lib/notifications) ────────────────────────────────
# С какого уровня отправлять (INFO|SUCCESS|WARNING|CRITICAL). Запросы
# одобрения уходят всегда тем, кто может одобрять.
NOTIFY_TELEGRAM_MIN_LEVEL=WARNING
NOTIFY_EMAIL_MIN_LEVEL=CRITICAL
# Повтор одинакового уведомления не чаще раза в N минут.
NOTIFY_COOLDOWN_MINUTES=30
# Тихие часы для Telegram (кроме CRITICAL и запросов одобрения), часы «с-до».
NOTIFY_QUIET_HOURS=23-8
NOTIFY_TIMEZONE=Asia/Almaty
# Подпись кнопок «Одобрить / Отклонить» и кнопок меню ботов. Если пусто —
# используется секрет вебхука бота (TELEGRAM_ADMIN_WEBHOOK_SECRET /
# TELEGRAM_WEBHOOK_SECRET / TELEGRAM_EXPERT_WEBHOOK_SECRET). Без них функции
# персонала в боте выключены. Новые кнопки подписываются первым заданным,
# принимаются любым — смена ключа не ломает отправленные карточки.
TELEGRAM_CALLBACK_SECRET=

# ─── Документы (lib/documents) ──────────────────────────────────────────────
# Максимальный размер загружаемого файла в байтах (по умолчанию 25 МБ).
DOCUMENT_MAX_BYTES=26214400
# Распознавание сканов (OCR, lib/documents/ocr.ts). Включено по умолчанию, если
# есть языковые данные: npm-пакеты @tesseract.js-data/{rus,eng,kaz} (офлайн,
# ничего не скачивается). false — выключить: сканы получат статус needs_ocr.
DOCUMENT_OCR_ENABLED=
# Языки через запятую (по умолчанию rus,eng; казахский: rus,eng,kaz — медленнее).
DOCUMENT_OCR_LANGS=rus,eng
# Сколько страниц PDF распознавать за запуск (по умолчанию 15, максимум 50).
# Не успели к дедлайну — частичный результат с пометкой partial.
DOCUMENT_OCR_MAX_PAGES=15
# Движок: auto (удалённый, если зарегистрирован через registerRemoteOcr(),
# иначе локальный tesseract) | local | remote. Сбой удалённого — локальный.
DOCUMENT_OCR_ENGINE=auto
# Необязательно: локальная папка с <lang>.traineddata[.gz] вместо пакетов
# (URL не принимается — данные никогда не загружаются из сети).
DOCUMENT_OCR_LANG_PATH=

# ─── CRM и демо-доступ ───────────────────────────────────────────────────────
# Хосты self-hosted Bitrix24/amoCRM через запятую (облачные домены разрешены
# всегда). Адреса проверяются: только публичные IP, только https.
CRM_ALLOWED_CUSTOM_HOSTS=
# Демо-вход: работает только при регистрации по приглашению и значении true.
DEMO_ACCESS_ENABLED=false
